---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Marquee from '../components/Marquee.astro';
import Shot from '../components/Shot.astro';
import Hero3D from '../components/Hero3D.astro';
import { SITE, LINKS } from '../config/site.js';
import { getReleases, formatReleaseDate } from '../lib/releases.js';
import { softwareSchema, websiteSchema, faqSchema } from '../lib/schema.js';
import { HOME_FAQS, LITTLE_THINGS } from '../content/home.js';

const releases = await getReleases();
const latest = releases[0] || null;
const recent = releases.slice(0, 4);

const jsonLd = [websiteSchema(), softwareSchema(latest), faqSchema(HOME_FAQS)];

const FEATURES = [
  {
    id: 'stack',
    eyebrow: 'Smart Stack',
    title: 'One card. Four widgets.',
    text: 'Scroll over the weather card and it flips to a currency converter, gold & silver rates, then markets, just like a macOS Smart Stack. Click any card to expand it.',
    ticks: ['Weather with an hourly forecast', 'Currency converter: 36 currencies, works offline', 'Gold 24K / 22K / 18K & sovereign, silver per kg', 'NIFTY 50 & SENSEX at a glance'],
    href: '/features/smart-stack',
    link: 'Explore the Smart Stack',
    shot: 'stack-gold-expanded',
    alt: 'iWeb Smart Stack showing the gold and silver card expanded on the new tab',
  },
  {
    id: 'spotlight',
    eyebrow: 'Spotlight',
    title: 'Ask your new tab anything.',
    text: 'Press Ctrl+K. Type “100 usd to inr”, “nifty” or “22k gold” and get the answer instantly, or jump straight to a web, image, video or map search.',
    ticks: ['Currency, index, stock and gold answers', 'Enter copies or opens the Markets app', 'Keyboard first, everywhere'],
    href: '/features/spotlight',
    link: 'See what Spotlight can do',
    shot: 'spotlight-currency',
    alt: 'iWeb Spotlight search answering 100 USD to INR',
  },
  {
    id: 'markets',
    eyebrow: 'Markets',
    title: 'The market, one click away.',
    text: 'NIFTY 50, SENSEX, NIFTY Bank and any NSE/BSE stock in your watchlist, with 1D–5Y charts. Gold and silver are priced in rupees, with India retail estimates.',
    ticks: ['Searchable, reorderable watchlist', 'Interactive charts with hover', 'Delayed data · not investment advice'],
    href: '/features/markets',
    link: 'Explore Markets',
    shot: 'markets-app',
    alt: 'iWeb Markets app showing the NIFTY 50 chart and watchlist',
  },
  {
    id: 'wallpapers',
    eyebrow: 'Wallpapers',
    title: 'Make it yours.',
    text: "Drop in your own photos or pick from Unsplash's photographers. Wallpapers fade in smoothly, stay cached for offline use, and the clock adapts its colour to each one.",
    ticks: ['Bulk import, duplicate detection', 'Unsplash topics & search, credited', 'Offline cache, smooth crossfades'],
    href: '/features/wallpapers',
    link: 'Explore wallpapers',
    shot: 'wallpapers-settings',
    alt: 'iWeb wallpaper settings with the Unsplash gallery',
  },
];
---
<Base
  title={`${SITE.name}: ${SITE.descriptor}`}
  description="Turn every new tab into a calm macOS-style dashboard: widgets, Spotlight search, live markets, wallpapers and music. Free, private, no sign-up."
  jsonLd={jsonLd}
  bodyClass="home"
>
  <Hero3D latest={latest} />

  <Marquee items={['Smart Stack', 'Spotlight', 'Markets', 'Wallpapers', 'Music', 'Notes']} direction={1} />
  <Marquee items={['Your new tab, reimagined', 'Free & open source', 'Private by design']} direction={-1} outline />

  <!-- Pinned zoom: the dashboard grows from a card to full-bleed -->
  <section id="fresh-start" class="zoom" data-scene="zoom" aria-labelledby="fresh-title">
    <div class="zoom-pin">
      <div class="zoom-copy container">
        <span class="eyebrow">The dashboard</span>
        <h2 id="fresh-title" class="h2">Every tab is a fresh start.</h2>
        <p class="lead">
          The clock, your name, a quote, your favourite sites and a search bar. {SITE.name} opens
          instantly and stays out of the way until you need it.
        </p>
      </div>
      <Shot name="dashboard" alt="The iWeb new tab dashboard with clock, greeting, search, Smart Stack and dock" class="zoom-frame" sizes="100vw" />
    </div>
  </section>

  <!-- Horizontal gallery of the four headline features -->
  <section class="hscroll" data-scene="features" aria-label="Features">
    <div class="hscroll-pin">
      <div class="hscroll-track">
        <div class="hpanel hpanel-intro">
          <span class="eyebrow">What's inside</span>
          <h2 class="h2">Four ways your tab works harder.</h2>
          <p class="lead">Keep scrolling: each one is a single gesture away on every new tab.</p>
        </div>
        {FEATURES.map((feature, index) => (
          <article class={`hpanel hpanel-${feature.id}`} aria-labelledby={`${feature.id}-title`}>
            <div class="hpanel-copy">
              <span class="hpanel-index">0{index + 1}</span>
              <span class="eyebrow">{feature.eyebrow}</span>
              <h2 id={`${feature.id}-title`} class="h2">{feature.title}</h2>
              <p class="lead">{feature.text}</p>
              <ul class="ticks">{feature.ticks.map((tick) => <li>{tick}</li>)}</ul>
              <a class="text-link" href={feature.href}>{feature.link}</a>
            </div>
            <Shot name={feature.shot} alt={feature.alt} class="hpanel-frame" sizes="(min-width: 900px) 45vw, 100vw" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Music -->
  <section class="section" data-scene="music" data-tint="violet" aria-labelledby="music-title">
    <div class="container split">
      <div>
        <span class="eyebrow">Music</span>
        <h2 id="music-title" class="h2">Your music, in a Dynamic Island.</h2>
        <p class="lead">
          Point {SITE.name} at a folder of songs and it becomes a full music library with playlists,
          favourites and smart search (“play something calm”). Playback controls live in a Dynamic
          Island at the top of the page.
        </p>
      </div>
      <div class="island-demo" aria-hidden="true">
        <div class="island">
          <span class="island-art"></span>
          <span class="island-text"><strong>Midnight City</strong><span>Now playing</span></span>
          <span class="island-wave"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stacked cards -->
  <section class="section stack-section" data-scene="details" aria-labelledby="details-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Details</span>
        <h2 id="details-title" class="h2">Thoughtful down to the details.</h2>
      </div>
      <div class="stack-cards">
        {LITTLE_THINGS.map((item, index) => (
          <article class="stack-card" style={`--i:${index}`}>
            <span class="stack-num">0{index + 1}</span>
            <div>
              <h3 class="h3">{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Privacy: words fill in and gain weight as you scroll -->
  <section class="section statement-section" data-scene="privacy" aria-labelledby="privacy-title">
    <div class="container">
      <h2 id="privacy-title" class="statement" data-fill>Your tab. Your data. No account, no tracking, nothing leaves your browser unless you ask.</h2>
      <p class="lead" style="margin-top: 48px">
        Your notes, music, wallpapers and settings live in your browser and nowhere else. {SITE.name}
        only goes online for the features you use: weather, rates, markets and photos.
      </p>
      <a class="text-link" href="/privacy">Read exactly what is sent</a>
    </div>
  </section>

  <!-- Always improving -->
  <section class="section" data-scene="releases" aria-labelledby="releases-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Changelog</span>
        <h2 id="releases-title" class="h2">Always improving.</h2>
        <p class="lead">New features ship often, and {SITE.name} installs them for you.</p>
      </div>
      {recent.length > 0 ? (
        <ol class="timeline">
          {recent.map((release) => (
            <li>
              <a class="version" href={release.url} rel="noopener">{release.tag}</a>
              <div>
                <time datetime={release.date}>{formatReleaseDate(release.date)}</time>
                <span class="muted">{release.name}</span>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted">See every release on <a href={LINKS.releases} rel="noopener">GitHub</a>.</p>
      )}
      <a class="text-link" href="/changelog">Full changelog</a>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section cta-band cta-big" aria-labelledby="cta-title">
    <h2 id="cta-title" class="h2">Start every tab beautifully.</h2>
    <p class="lead">Free, open source and private. Installs in under a minute.</p>
    <div class="actions">
      <a class="btn btn-primary btn-large" href={LINKS.install} data-magnetic>Get {SITE.name} for Chrome</a>
      <a class="btn btn-ghost" href={LINKS.github} rel="noopener" data-magnetic>View on GitHub</a>
    </div>
  </section>

  <Faq faqs={HOME_FAQS} />
</Base>
